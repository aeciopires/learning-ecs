# Copy to .env and load it (`set -a; source .env; set +a`) before running
# `uv run cdk ...`. Every variable below is optional: unset, it takes the
# default shown. See REQUIREMENTS.md section 9 and shared/config.py.
#
# This file is written for floci (the local emulator). For a real AWS
# account, see REQUIREMENTS.md section 9.2 - in short: unset the floci block
# at the bottom, and comment out the CDK_PORT_* lines.

# Silences the jsii runtime's "untested Node.js version" banner (Node.js 26
# is newer than the releases jsii lists as tested) - see REQUIREMENTS.md
# section 3.
JSII_SILENCE_WARNING_UNTESTED_NODE_VERSION=1

# --- Tag values (shared/tagging.py) -------------------------------------------
CDK_PRODUCT=learning-ecs
CDK_ENVIRONMENT=dev            # dev, stg, or prd (short names only)
CDK_TEAM_OWNER=platform-engineering
CDK_PCI=false
CDK_CELL_BASED=false
# CDK_CELL_ID=cell-01          # only read when CDK_CELL_BASED=true

# --- Network (shared/network.py) -----------------------------------------------
CDK_VPC_CIDR=10.0.0.0/16
CDK_MAX_AZS=2                  # 2+ = multi-AZ; every module spreads tasks across them
CDK_NAT_GATEWAYS=1             # 0 = no NAT Gateway: tasks then run in public subnets
CDK_TASK_SUBNETS=private       # private | public
# CDK_VPC_FLOW_LOGS=false      # modules/01_network
# CDK_VPC_S3_ENDPOINT=true     # modules/01_network

# --- ECS defaults (shared/ecs.py) ------------------------------------------------
CDK_CONTAINER_INSIGHTS=enhanced   # disabled | enabled | enhanced
CDK_LOG_RETENTION_DAYS=7          # a value CloudWatch Logs accepts (1, 3, 5, 7, 14, 30, ...)

# --- Listener ports (floci only) ----------------------------------------------------
# On real AWS every load balancer has its own IP addresses, so they can all
# listen on 80. floci binds every listener on its own container, so each one
# needs a port no other listener uses - and docker-compose.yml publishes
# 8080-8099 to your machine. Comment these out for real AWS: each listener
# then uses its default (80, or the one its module's README names when two
# listeners share a load balancer). See REQUIREMENTS.md sections 6 and 10.
CDK_PORT_ALB_PUBLIC=8081
CDK_PORT_ALB_INTERNAL=8082
CDK_PORT_NLB_PUBLIC=8083
CDK_PORT_NLB_INTERNAL=8084
CDK_PORT_API_GATEWAY=8085
CDK_PORT_CLOUDFRONT_ALB=8086
CDK_PORT_SERVICE_CONNECT=8087
CDK_PORT_RDS_MYSQL=8088
CDK_PORT_RDS_POSTGRESQL=8089
CDK_PORT_AURORA=8090
CDK_PORT_AUTOSCALING=8091
CDK_PORT_DEPLOYMENTS=8092
CDK_PORT_DEPLOYMENTS_TEST=8093
CDK_PORT_MULTI_REGION=8094
CDK_PORT_MULTI_REGION_SECONDARY=8099
CDK_PORT_CLOUDWATCH=8095
CDK_PORT_PROMETHEUS_APP=8080
CDK_PORT_PROMETHEUS=8096
CDK_PORT_GRAFANA=8097
CDK_PORT_DATADOG=8098

# --- AWS account/region (shared/config.py) -----------------------------------------
# Left unset, the CDK CLI fills CDK_DEFAULT_ACCOUNT/CDK_DEFAULT_REGION from
# your current credentials/profile - see
# https://docs.aws.amazon.com/cdk/v2/guide/environments.html
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1

# --- floci (local AWS emulator, see docker-compose.yml) ----------------------------
# `eval $(floci env)` (floci CLI) sets the same four variables.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- floci-only module overrides ---------------------------------------------------
# floci 2.1.0 implements no API Gateway VPC links, so module 06 calls an
# internet-facing load balancer instead (README of modules/06_api_gateway).
CDK_APIGW_CONNECTION=internet
# ...and floci's API Gateway can't resolve the *.elb.floci names floci hands
# out, but the listener also answers on floci's own localhost:
CDK_APIGW_BACKEND_URL=http://localhost:8085
# floci's CloudFront can't resolve *.elb.floci either: module 07's origin is
# floci's own localhost (allow-listed in docker-compose.yml).
CDK_CLOUDFRONT_ORIGIN_DOMAIN=localhost
# floci's CloudFormation doesn't create ElastiCache resources: module 12
# uses a cache created with the AWS CLI (see its README), reachable from
# the ECS tasks at floci:6379, without TLS.
CDK_CACHE_ENDPOINT=floci
CDK_CACHE_TLS=false
# floci's CloudFormation doesn't create DocumentDB resources either: module 13
# uses a cluster created with the AWS CLI (export CDK_DOCDB_ENDPOINT as its
# README shows), and floci's MongoDB container doesn't offer TLS.
CDK_DOCDB_TLS=false
# floci's CloudFront can't resolve *.elb.floci (see above): module 18's
# origins are the two regional listeners on floci's own localhost.
CDK_MULTI_REGION_PRIMARY_ORIGIN=localhost
CDK_MULTI_REGION_PRIMARY_ORIGIN_PORT=8094
CDK_MULTI_REGION_SECONDARY_ORIGIN=localhost
CDK_MULTI_REGION_SECONDARY_ORIGIN_PORT=8099
# floci gives tasks no ECS task metadata endpoint, which the ADOT collector's
# awsecscontainermetrics receiver needs to start (module 20).
CDK_PROMETHEUS_ECS_METRICS=false
# ...and runs a task's containers without a shared localhost, so the ADOT
# sidecar scrapes the app through the ALB - with one task, so the counters
# come from a single Caddy (module 20 README, "floci vs real AWS").
CDK_PROMETHEUS_SCRAPE_VIA_ALB=true
CDK_PROMETHEUS_DESIRED_COUNT=1
